# Khóa model được cấu hình riêng trong giao diện Egoric Film Studio.
# Các giá trị dưới đây là credential OAuth phía server; chỉ đặt ở Sites runtime,
# không commit giá trị thật và không gửi chúng xuống trình duyệt.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
DISTRIBUTION_TOKEN_KEY=

# Email mời nhân sự (server-only). Xác minh domain gửi trên Resend trước khi bật.
RESEND_API_KEY=
EGORIC_INVITE_FROM_EMAIL=Egoric Agency <team@your-domain.com>

# URL public nơi nhân sự mở link mời. Để trống nếu trùng với origin đang chạy.
EGORIC_PUBLIC_URL=
