{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "egoric-film-studio",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "egoric-film-studio",
      "database_id": "542b39c9-f4c2-491a-950e-a9f6004ffa4a",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "EGORIC_OWNER_EMAIL": "leozvu.work@gmail.com"
  }
}
